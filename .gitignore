# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Conda environment files (less common inside project, but good practice)
conda-meta/
env/
conda-bld/

# Log files
*.log
flask_app.log

# JSON files
*.json

# OS generated files
.DS_Store
Thumbs.db

# IDE / Editor specific files (examples, add yours if needed)
.idea/
.vscode/
*.swp

# Sensitive files (should use env vars, but as safety net)
.env
# secrets.yaml
# Ignore JSON files except those in data directory
*.json
!data/**/*.json

# Production runtime files
gunicorn.pid
venv/

# Conda environment (local)
miniconda3/
